# Copy to .env for local development: cp .env.example .env
# Every value below is a development placeholder. NEVER reuse them anywhere real.
# In production, inject secrets from a secret manager and set APP_ENV=production:
# the API refuses to start with placeholder secrets, short secrets or development switches enabled.

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=["http://localhost"]
HTTP_PORT=80
COOKIE_SECURE=false

# --- data stores (development passwords only) --------------------------------------------------
POSTGRES_USER=davos
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=davos
REDIS_PASSWORD=dev-only-redis-password
MINIO_ROOT_USER=davos-minio
MINIO_ROOT_PASSWORD=dev-only-minio-password

# --- application secrets: each has one purpose; generate with `openssl rand -hex 32` -------------
OTP_HMAC_SECRET=dev-only-insecure-secret-change-me-0123456789
SESSION_CSRF_SECRET=dev-only-insecure-secret-change-me-0123456789
BOOKING_WEBHOOK_SECRET=dev-only-insecure-secret-change-me-0123456789

# --- development-only switches (rejected in production) ------------------------------------------
# When true the recording SMS gateway logs OTP codes so you can sign in locally. Keep false otherwise.
DEV_SMS_ECHO_ENABLED=false

# --- AI assistant: any OpenAI-compatible provider (chat completions). Leave empty for FAQ-links-only mode. ------
# 1. AI_BASE_URL  the provider's API root WITHOUT /chat/completions, e.g. https://api.openai.com/v1
#                 (the code appends /chat/completions). http:// is accepted only in development.
# 2. AI_API_KEY   your secret key. It stays on the server and is never sent to the browser.
# 3. AI_MODEL     the exact model id your provider documents. It is deliberately not hardcoded anywhere.
# After editing, apply with:  docker compose up -d api    (plain "restart" does not re-read .env)
# Tone/style notes live in backend/prompts/assistant_persona.txt, knowledge in backend/knowledge/*.txt.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Some providers/models want max_completion_tokens instead of max_tokens.
AI_TOKEN_LIMIT_PARAM=max_tokens
AI_DAILY_TOKEN_BUDGET=400000

# --- semantic answer cache (everything local: no API is called for it) ----------------------------------------
# A question that means the same as one already answered gets the stored answer at once, without the model and
# without spending tokens. Embeddings are computed on this machine by a model stored as files in backend/models;
# vectors live in PostgreSQL (pgvector). Set up once, see docs/SEMANTIC_CACHE.md:
#   docker compose build api && docker compose --profile tools run --rm fetch-embedding-model
# Without that folder the cache stays off and the assistant works exactly as before.
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity (0.5 - 1.0) two questions need to share an answer. Higher = safer and fewer hits. 0.94 was
# measured on the real model: it serves everyday rewordings and confuses no topics, while 0.88 wrongly served 15 of 405
# different-topic pairs. Re-check with: docker compose exec api python -m davos.tools.calibrate_semantic_cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94

# --- external integrations (disabled until credentials exist) ------------------------------------
BOOKING_BASE_URL=https://booking.davoskarting.ir
BOOKING_INTEGRATION_ENABLED=false
PAYMENTS_ENABLED=false
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=
