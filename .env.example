# Davos Karting configuration. Copy to .env and fill in:   cp .env.example .env
#
# Every value the backend and the web app use lives in .env; the code has no defaults. A missing setting stops the
# program at start-up with its name. This file is a complete, working development setup and the reference for what each
# setting means; backend/src/davos/platform/settings/app_settings.py declares them in the same order, and a test fails
# when the two disagree. Passwords and secrets here are development placeholders: NEVER reuse one anywhere real.
#
# Apply changes: `docker compose up -d` (the API, worker and scheduler read this whole file; `restart` does not
# re-read it). Values marked [build] are baked into the web app: `docker compose build frontend` after changing them.
# Production: set APP_ENV=production and inject secrets from a secret manager; the API refuses to start with the
# example secrets, short secrets, development switches or http:// addresses.

# ---- site ---------------------------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# [build] The main site, and the booking subdomain (empty = booking stays on the main site at /booking).
# Local split-host test: PUBLIC_BASE_URL=http://localhost:8088 and BOOKING_BASE_URL=http://booking.localhost:8088
PUBLIC_BASE_URL=http://localhost
BOOKING_BASE_URL=
# Extra origins allowed to call the API from a browser (the two addresses above are always allowed).
CORS_ALLOWED_ORIGINS=["http://localhost"]
# [build] The venue's public phone number: shown on the site and quoted by the assistant.
CONTACT_PHONE=09177334894
# [build] The track's location for the map link.
VENUE_LATITUDE=29.76912
VENUE_LONGITUDE=52.49991

# ---- containers (docker-compose.yml) ---------------------------------------------------------------------------------
HTTP_PORT=80
# API worker processes; keep API_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + ~10 under PostgreSQL's 100 connections.
API_WORKERS=4
# Web app replicas: each renders ~25-35 pages per second; nginx spreads requests over all of them.
FRONTEND_REPLICAS=3
DAVOS_VERSION=dev

# ---- data stores (development passwords only) ------------------------------------------------------------------------
POSTGRES_USER=davos
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=davos
REDIS_PASSWORD=dev-only-redis-password
MINIO_ROOT_USER=davos-minio
MINIO_ROOT_PASSWORD=dev-only-minio-password
# For running the backend outside Docker (tests, tools); docker-compose.yml gives the containers their own
# addresses, built from the passwords above.
DATABASE_URL=postgresql+asyncpg://davos:dev-only-postgres-password@localhost:5432/davos
REDIS_URL=redis://:dev-only-redis-password@localhost:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10.0
# Connections the API keeps open to outside services (AI provider, bank, SMS), shared by all of them.
OUTBOUND_HTTP_MAX_CONNECTIONS=20

# ---- application secrets: one purpose each; generate with `openssl rand -hex 32` --------------------------------------
OTP_HMAC_SECRET=dev-only-insecure-secret-change-me-0123456789
SESSION_CSRF_SECRET=dev-only-insecure-secret-change-me-0123456789
BOOKING_WEBHOOK_SECRET=dev-only-insecure-secret-change-me-0123456789
# Accepted too while rotating BOOKING_WEBHOOK_SECRET; empty otherwise.
BOOKING_WEBHOOK_SECRET_PREVIOUS=

# ---- development-only switches (rejected in production) --------------------------------------------------------------
# true: no SMS is sent and the sign-in form shows the code. Keep false anywhere real.
DEV_SMS_ECHO_ENABLED=false

# ---- customer sign-in (SMS one-time code) and sessions -----------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
# The real anti-abuse limit is per mobile number; per-IP limits are generous because mobile operators put many
# customers behind one IP (carrier-grade NAT).
OTP_REQUESTS_PER_MOBILE_PER_HOUR=5
OTP_REQUESTS_PER_IP_PER_HOUR=200
OTP_VERIFICATIONS_PER_IP_PER_15_MINUTES=300
SESSION_COOKIE_NAME=davos_session
SESSION_LIFETIME_DAYS=30
# false only for plain-http local development.
COOKIE_SECURE=false

# ---- admin panel (/admin) ----------------------------------------------------------------------------------------------
ADMIN_COOKIE_NAME=davos_admin
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_TIMEOUT_MINUTES=120
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_LOGINS_PER_IP_PER_15_MINUTES=20
# Creates the first owner account at start-up when no admin exists yet; ignored afterwards. Use a long password and
# remove it from .env after the first login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- AI assistant: any OpenAI-compatible provider (chat completions); empty = FAQ-links-only mode ------------------------
# AI_BASE_URL: the provider's API root WITHOUT /chat/completions, e.g. https://api.gapgpt.app/v1 (http:// only in
# development). AI_API_KEY stays on the server. AI_MODEL: the exact model id; it is not hardcoded anywhere.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=12.0
# Reasoning models (gpt-5*, gpt-6*, o*) want max_completion_tokens, no temperature and a larger output floor.
AI_TOKEN_LIMIT_PARAM=max_tokens
AI_SEND_TEMPERATURE=true
AI_TEMPERATURE=0.1
AI_MIN_OUTPUT_TOKENS=0
AI_MAX_OUTPUT_TOKENS=400
# Shared by all API workers (Redis); about 2-5k tokens per model-answered question.
AI_DAILY_TOKEN_BUDGET=400000
AI_MAX_CONCURRENCY=8
AI_QUEUE_WAIT_SECONDS=0.5
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_RECOVERY_SECONDS=30.0
# Optional backup model on the same provider, asked only when AI_MODEL fails or times out.
AI_FALLBACK_MODEL=
AI_FALLBACK_TOKEN_LIMIT_PARAM=max_tokens
AI_FALLBACK_SEND_TEMPERATURE=true
AI_FALLBACK_MIN_OUTPUT_TOKENS=0
# The owner's style notes and knowledge folder (empty = off); docker-compose.yml sets the API's to the mounted
# backend/prompts and backend/knowledge.
ASSISTANT_PERSONA_FILE=
ASSISTANT_KNOWLEDGE_DIR=
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_QUESTIONS_PER_IP_PER_HOUR=120
ASSISTANT_QUESTIONS_PER_CONVERSATION=20
# Stored interactions (only with the customer's consent) are purged after this many days.
ASSISTANT_RETENTION_DAYS=90
# How stale the admin-panel settings the assistant quotes may be.
ASSISTANT_BOOKING_FACTS_CACHE_SECONDS=30.0
# The short follow-up memory ("و برای پنجشنبه؟").
CONVERSATION_CONTEXT_TURNS=3
CONVERSATION_CONTEXT_TTL_SECONDS=1200
# Answer cache: a general question that means the same as one answered before gets the stored answer, found by
# meaning with a small embedding model on this machine. Fetch the model once:
#   backend/.venv/Scripts/python.exe -m davos.tools.fetch_embedding_model backend/models/paraphrase-multilingual-minilm
# docker-compose.yml points the API at the mounted folder; without the files the cache stays off.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_MODEL_DIR=backend/models/paraphrase-multilingual-minilm
# Measured with `python -m davos.tools.evaluate_answer_cache` (docs/ASSISTANT_EVALUATION.md), not guessed.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85
SEMANTIC_CACHE_CANDIDATE_LIMIT=8
SEMANTIC_CACHE_MAX_TEXT_CHARS=400
SEMANTIC_CACHE_THREADS=1

# ---- online payments -----------------------------------------------------------------------------------------------------
# The bank only accepts calls from the server IP registered with it. The callback defaults to the booking site
# + /api/v1/payments/<provider>/callback; it must be https in production.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mellat
PAYMENT_CALLBACK_URL=
PAYMENT_GATEWAY_TIMEOUT_SECONDS=20.0
PAYMENT_ATTEMPT_TTL_MINUTES=30
# A paid reservation keeps its karts this long while the payment is recorded (also after its hold ran out).
PAYMENT_HOLD_EXTENSION_MINUTES=10
PAYMENT_CALLBACKS_PER_IP_PER_MINUTE=30
PAYMENT_RECONCILE_AFTER_SECONDS=120
PAYMENT_RECONCILE_BATCH_SIZE=50
# Bank Mellat (Behpardakht). [build] MELLAT_START_PAY_URL is also the only outside address the site's forms may post to.
MELLAT_TERMINAL_ID=0
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_SERVICE_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw
MELLAT_START_PAY_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
# Alternative gateway (PAYMENT_PROVIDER=zarinpal).
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_API_HOST=https://payment.zarinpal.com
ZARINPAL_SANDBOX_HOST=https://sandbox.zarinpal.com
# Lets developers pay a labelled test order against the sandbox. Rejected in production.
PAYMENTS_SANDBOX_ORDERS_ENABLED=false

# ---- SMS: "recording" sends nothing (development), "kavenegar" sends ------------------------------------------------------
# Templates are created and approved in the Kavenegar panel (verify/lookup).
SMS_PROVIDER=recording
KAVENEGAR_API_URL=https://api.kavenegar.com/v1
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_RESERVATION_TEMPLATE=
SMS_TIMEOUT_SECONDS=10.0

# ---- integration with the counter's booking app (off until it has credentials) -----------------------------------------
BOOKING_INTEGRATION_ENABLED=false
BOOKING_WEBHOOK_TOLERANCE_SECONDS=300
